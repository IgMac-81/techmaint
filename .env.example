# Copie este arquivo para .env e ajuste. O .env NUNCA vai para o Git.
FLASK_ENV=dev
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Deixe DATABASE_URL comentado para usar o SQLite padrão em instance/techmaint.db
# (caminho absoluto calculado automaticamente pelo app/config.py — evita erro
# "unable to open database file" no Windows, onde um caminho relativo depende
# do diretório de onde o comando foi executado).
# DATABASE_URL=sqlite:///instance/techmaint.db
